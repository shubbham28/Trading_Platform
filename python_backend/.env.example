# Alpaca market data and paper trading
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_API_SECRET=your_alpaca_api_secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Live trading credentials. Separate keys on purpose: with one shared pair,
# flipping TRADING_MODE points the same keys at a live account, and that is the
# accident this design removes. Leave blank until you intend to trade live.
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_API_SECRET=

# paper | live
TRADING_MODE=paper

# Postgres. No SQLite default: a silent fallback to a local file would let the
# app look healthy while writing bot state and audit rows nobody is watching.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/trading_platform

# Account-wide risk limits. Per-bot limits live in bots.risk_limits instead,
# because they differ per bot; these apply to every bot's orders together.
# Defaults shown. Every one of them restricts only orders that INCREASE
# exposure -- no risk rule can block an order that closes a position.
RISK_MAX_TOTAL_EXPOSURE_PCT=100
RISK_MAX_DAILY_LOSS_PCT=5
RISK_MAX_OPEN_POSITIONS=10

# Python Backend Configuration
PYTHON_BACKEND_PORT=8000
